{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "http://YOUR_EC2_PUBLIC_IP:8000/api/:path*"
    },
    {
      "source": "/v1/:path*",
      "destination": "http://YOUR_EC2_PUBLIC_IP:8000/v1/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
